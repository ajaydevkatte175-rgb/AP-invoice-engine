# Application environment (e.g. development, staging, production)
APP_ENV=

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=

# Application secret key for session/token signing (at least 32 characters)
SECRET_KEY=

# API authorization key for client requests
API_KEY=

# Primary PostgreSQL async connection string (asyncpg)
DATABASE_URL=

# Read-only PostgreSQL async connection string (asyncpg) for AI agent queries
DATABASE_URL_RO=

# Redis connection string for background job queue (ARQ)
REDIS_URL=

# Anthropic Claude API key for vision extraction and agent operations
ANTHROPIC_API_KEY=

# Monthly spend limit in USD for LLM API calls
LLM_MONTHLY_BUDGET_USD=

# Confidence threshold (0.0 to 1.0); lower confidence routes to human review
CONFIDENCE_THRESHOLD=

# Maximum allowed file upload size in megabytes
MAX_UPLOAD_MB=

# DPI resolution for rendering PDF pages to images
RENDER_DPI=

# Filesystem storage path for uploaded invoice files
STORAGE_PATH=

# Maximum rows returned by agent text-to-SQL queries
AGENT_MAX_ROWS=

# Statement timeout in milliseconds for agent text-to-SQL queries
AGENT_QUERY_TIMEOUT_MS=

# Base URL for the backend API service
API_URL=

